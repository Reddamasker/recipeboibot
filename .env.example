# Server
YTDLP_PATH=yt-dlp
PORT=3087
APP_URL=https://example.test
DATABASE_PATH=./data/recipes.sqlite
# Optional override for the project owner's feedback inbox in Telegram.
FEEDBACK_CHAT_ID=6971956699
TRUST_PROXY=false

# Real providers
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.6-luna
# Dinner recipe generation model; defaults to OPENAI_TEXT_MODEL. false uses the ready catalog fallback.
DINNER_TEXT_MODEL=
# Independent semantic recipe validator; defaults to DINNER_TEXT_MODEL, then OPENAI_TEXT_MODEL.
DINNER_VALIDATOR_MODEL=
DINNER_LLM_ENABLED=true
# First request generates 6 complete recipes; later requests replenish 3 in the background.
DINNER_GENERATION_TIMEOUT_MS=60000
# Illustrations load independently; never block choosing dinner. Uses OPENAI_IMAGE_MODEL.
DINNER_IMAGES_ENABLED=true
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
TELEGRAM_BOT_TOKEN=
TELEGRAM_POLLING=true

# Robokassa. Keep passwords only in the server environment, never in Git.
# PAYMENT_TAX is required when credentials are set (for example: none, vat0, vat10, vat20).
# Keep false before launch. Set true together with complete Robokassa credentials;
# startup then fails instead of silently opening paid imports for free.
BILLING_REQUIRED=false
ROBOKASSA_MERCHANT_LOGIN=
ROBOKASSA_PASSWORD1=
ROBOKASSA_PASSWORD2=
ROBOKASSA_HASH_ALGORITHM=md5
ROBOKASSA_TEST=false
# Production-only relay for test ResultURL notifications when one Robokassa shop serves both contours.
ROBOKASSA_TEST_RESULT_URL=
# Enable only after recurring payments are approved for the Robokassa shop.
ROBOKASSA_RECURRING_ENABLED=false
PAYMENT_TAX=
PAYMENT_SNO=
PAYMENT_METHOD=full_payment
PAYMENT_PRICE_VARIANTS=199
PAYMENT_EXPERIMENT_KEY=monthly-price-199-v1

# Input and upload size limits
# Main dashboard only. OAuth token stays in the server's private .env.local.
YANDEX_DIRECT_TOKEN=
YANDEX_DIRECT_LOGIN=spassky1997
YANDEX_DIRECT_CAMPAIGN_ID=715053149
YANDEX_DIRECT_PLACEMENT=ya-dinner-202610

# Input and upload size limits
AI_MAX_INPUT_CHARS=30000
MAX_UPLOAD_BYTES=6291456
MAX_REMOTE_BYTES=1572864
